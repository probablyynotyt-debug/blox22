rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connectivity check
    match /test/{docId} {
      allow read: if true;
    }

    // Users Collection (Public profiles, avatars, friends, search)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isOwner(userId);
    }

    // Experiences Collection (published games, baseplates)
    match /experiences/{expId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Multiplayer Active Game Presence
    match /active_games/{expId}/players/{userId} {
      allow read, write: if true;
    }

    // Multiplayer In-Game Chat Messages
    match /active_games/{expId}/chat_messages/{msgId} {
      allow read, write: if true;
    }

    // Marketplace Items (community clothing: shirts & pants)
    match /marketplace_items/{itemId} {
      allow read, write: if true;
    }
  }
}
